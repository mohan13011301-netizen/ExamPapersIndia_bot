import logging
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes

# ENABLE LOGGING
logging.basicConfig(format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', level=logging.INFO)
logger = logging.getLogger(__name__)

# YOUR BOT TOKEN FROM BOTFATHER
TOKEN = "YOUR_BOT_TOKEN_HERE"

# MEDIAFIRE DIRECT LINKS
MEDIAFIRE_LINKS = {
    "ME2007": "https://www.mediafire.com/file/YOUR_CODE/ME2007.pdf?dl=1",
    "ME1-2017": "https://www.mediafire.com/file/zhhtlbpxvh3iu2l/ME1-2017.pdf?dl=1",
    "ME1-2018": "https://www.mediafire.com/file/rc6rwiwgwjktyrg/ME1-2018.pdf?dl=1",
    "ME1-2019": "https://www.mediafire.com/file/1wj6x27k2auteay/ME1-2019.pdf?dl=1",
    # ADD MORE HERE
}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("📚 GATE ME Papers", callback_data="GATE_ME")],
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text(
        "🎓 *GATE Mechanical Engineering Bot*\n\n"
        "Click below to access previous year papers:",
        reply_markup=reply_markup,
        parse_mode='Markdown'
    )

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    if query.data == "GATE_ME":
        keyboard = [
            [InlineKeyboardButton("ME 2007", callback_data="ME2007")],
            [InlineKeyboardButton("ME1 2017", callback_data="ME1-2017")],
            [InlineKeyboardButton("ME1 2018", callback_data="ME1-2018")],
            [InlineKeyboardButton("ME1 2019", callback_data="ME1-2019")],
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.edit_message_text(
            "📋 *Select GATE ME Paper:*\n\n"
            "Choose year to download:",
            reply_markup=reply_markup,
            parse_mode='Markdown'
        )
    elif query.data in MEDIAFIRE_LINKS:
        await query.edit_message_text(
            f"📥 *Downloading {query.data}*\n\n"
            f"👆 Click link below:\n\n"
            f"[⬇️ Download {query.data}.pdf]({MEDIAFIRE_LINKS[query.data]})",
            parse_mode='Markdown',
            disable_web_page_preview=True
        )

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button))
    app.run_polling()

if __name__ == '__main__':
    main()
